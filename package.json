{
  "name": "slides",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "slidev",
    "dev:grill-me": "slidev decks/grill-me/slides.md --open",
    "export": "slidev export",
    "export:grill-me": "slidev export decks/grill-me/slides.md --output dist/grill-me.pdf",
    "export:all": "mkdir -p dist && for deck in decks/*/slides.md; do name=$(basename $(dirname \"$deck\")); npx slidev export \"$deck\" --output \"dist/$name.pdf\"; done"
  },
  "devDependencies": {
    "@slidev/cli": "^52.1.0",
    "@slidev/theme-default": "latest",
    "playwright-chromium": "^1.55.0"
  }
}
